{
  "schemaVersion": 1,
  "id": "dev.shellcanvas.database",
  "name": "ShellCanvas Database",
  "version": "0.1.0",
  "description": "Direct database connections for SQL Server, PostgreSQL, MySQL/MariaDB and SQLite.",
  "platform": "windows-x86_64",
  "entrypoint": "bin/shellcanvas-device.exe",
  "arguments": [],
  "files": [
    {
      "path": "bin/shellcanvas-device.exe",
      "size": 9617920,
      "sha256": "3997caf344c4ee0119cbc036ce6813a40150f1ee3b1c35489ae3cb7f22e89bea",
      "executable": true
    }
  ],
  "configuration": [
    {
      "id": "provider",
      "label": "Provider (sqlite, postgresql, mysql, mariadb, sqlserver)",
      "kind": "text",
      "required": true,
      "default": "sqlite"
    },
    {
      "id": "host",
      "label": "Database host",
      "kind": "text",
      "required": false,
      "default": "localhost"
    },
    {
      "id": "port",
      "label": "Port (leave 0 for provider default)",
      "kind": "number",
      "required": false,
      "default": 0
    },
    {
      "id": "database",
      "label": "Database name",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "id": "username",
      "label": "Username",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "id": "password",
      "label": "Password",
      "kind": "password",
      "required": false,
      "default": null
    },
    {
      "id": "tls",
      "label": "Use TLS",
      "kind": "boolean",
      "required": false,
      "default": true
    },
    {
      "id": "trustServerCertificate",
      "label": "Trust server certificate without identity verification",
      "kind": "boolean",
      "required": false,
      "default": false
    },
    {
      "id": "sqlitePath",
      "label": "SQLite path on the adapter machine",
      "kind": "text",
      "required": false,
      "default": ""
    }
  ]
}